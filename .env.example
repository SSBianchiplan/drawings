# GPlanSiS|Drawings — variáveis de ambiente do servidor (server/app.py).
# Copie para .env e ajuste. Valores abaixo são FICTÍCIOS.

# Banco PostgreSQL (o esquema "drawings" é criado automaticamente na partida)
DRAWINGS_DSN=postgresql://postgres@127.0.0.1:5432/drawings

# E-mail do administrador master (não pode ser rebaixado nem desativado)
DRAWINGS_MASTER=admin@exemplo.com

# Duração da sessão, em horas
DRAWINGS_SESSAO_HORAS=12

# Cookie com atributo Secure (1 em produção com HTTPS; 0 para http://127.0.0.1 local)
DRAWINGS_COOKIE_SEGURO=0

# Chave Fernet que cifra a chave da IA guardada pelo painel.
# Gere com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DRAWINGS_SEGREDO=troque-por-uma-chave-fernet

# Assistente IA (opcional). A chave também pode ser colada em Configurações › Assistente IA.
ANTHROPIC_API_KEY=
DRAWINGS_IA_MODELO=claude-opus-5-5

# Conversores LibreDWG (opcional; sem eles a leitura/gravação de DWG fica desligada)
DRAWINGS_DWG2DXF=/opt/libredwg/bin/dwg2dxf
DRAWINGS_DXF2DWG=/opt/libredwg/bin/dxf2dwg

# Endereço público (usado em links enviados ao GPlanSiS|Docs)
DRAWINGS_URL=http://127.0.0.1:8930

# Integração com o GPlanSiS|Docs (opcional)
DRAWINGS_DOCS_SEGREDO=
DRAWINGS_DOCS_URL=https://docs.exemplo.com
DRAWINGS_DOCS_API=http://127.0.0.1:8945/api
