# /etc/systemd/system/drawings.service
# GPlanSiS|Drawings — API (uvicorn no loopback, atrás do Caddy). Estáticos: Caddy em /opt/drawings/web.
[Unit]
Description=GPlanSiS|Drawings (CAD 2D/3D) — API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=drawings
Group=drawings
WorkingDirectory=/opt/drawings/server
EnvironmentFile=/opt/drawings/.env
ExecStart=/opt/drawings/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8930 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
